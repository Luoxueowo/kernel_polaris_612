<?xml version="1.0" encoding="UTF-8"?>
<!--
  Xiaomi MIX 2S (polaris) 机型项目。
  由 default.xml 通过 <include> 引入，repo init 默认即生效。
-->
<manifest>

  <remote name="github" fetch="https://github.com/Luoxueowo" />

  <!-- Qualcomm sdm845 platform layer, carries the polaris device tree -->
  <project path="vendor/qcom/sdm845"
           name="android_kernel_qcom_sdm845_612"
           remote="github"
           revision="polaris" />

</manifest>
